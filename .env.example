# ============================================================================
# YourBiz CRM — environment variables
# ----------------------------------------------------------------------------
# LOCAL DEVELOPMENT: none of these are required. Without Supabase variables
# the app runs on a built-in in-memory backend (data persists to
# db/dev-store.json while the dev server runs; it starts completely empty).
#
# PRODUCTION (Vercel): set these in Project Settings → Environment Variables.
# See README.md for the full step-by-step walkthrough.
# ============================================================================

# --- Supabase (REQUIRED in production) — Project Settings → API -----------
# The Project URL, e.g. https://abcdefghij.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon public" key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service_role" key — SERVER ONLY. Never expose it to the client.
# It bypasses RLS, so all API routes verify workspace membership themselves.
SUPABASE_SERVICE_ROLE_KEY=

# --- Transactional email via Resend (REQUIRED for sign-up/invite emails) --
# Create a free key at https://resend.com/api-keys
RESEND_API_KEY=

# The "From" address for every email the app sends.
# Without a verified domain you can use Resend's shared address, which only
# delivers to YOUR OWN Resend account email (fine for testing):
#   EMAIL_FROM="YourBiz CRM <onboarding@resend.dev>"
# For real sending to any user, verify your domain in Resend and use e.g.:
#   EMAIL_FROM="YourBiz CRM <no-reply@yourbiz-domain.com>"
EMAIL_FROM=

# --- Public app URL (used in email links like invitations) ----------------
# Your production URL, e.g. https://yourbiz-crm.vercel.app or your custom domain
NEXT_PUBLIC_APP_URL=

# --- Optional: local session signing (local dev backend only) ------------
# Defaults to a dev secret; irrelevant in production (Supabase auth is used).
# SESSION_SECRET=
